# URL project dari Supabase Dashboard > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=

# Publishable key (aman untuk browser, bukan service_role key)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Masuk dengan passkey (WebAuthn) di halaman /login dan /profil.
# Tetap false sampai tiga hal berikut final, karena Relying Party ID tidak bisa
# diubah lagi setelah ada penghuni mendaftar:
#   1. Supabase Dashboard > Authentication > Passkeys diaktifkan
#      (atau Management API PATCH /config/auth: passkey_enabled, webauthn_rp_id,
#       webauthn_rp_origins).
#   2. webauthn_rp_id = domain final tanpa subpath, bukan public suffix
#      (mis. app.example.com), dan harus sama dengan domain yang diakses.
#   3. webauthn_rp_origins memuat origin persis aplikasi (https://domain final;
#       http://localhost hanya untuk uji lokal, alamat IP LAN ditolak browser).
# Jalur uji lokal yang sudah terbukti jalan: RP ID `localhost` + origin
# http://localhost:3000 + flag true (konfirmasi Windows Hello di laptop).
NEXT_PUBLIC_ENABLE_PASSKEYS=false
